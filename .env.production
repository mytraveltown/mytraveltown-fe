# Used automatically by `npm run build` (Vite production mode).
# Overrides .env, so local development can keep pointing at localhost.
# Public values only: never put API keys or secrets in VITE_* variables.
VITE_API_URL=https://api.mytraveltown.com/api
VITE_MEDIA_URL=https://api.mytraveltown.com

# GST number shown on booking invoices (15 characters, e.g. 09ABCDE1234F1Z5)
VITE_COMPANY_GSTIN=
